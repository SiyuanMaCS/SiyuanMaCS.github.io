ze(im,(160,90),interpolation=cv2.INTER_AREA)\nZ=small.reshape(-1,3).astype(np.float32)\ncrit=(cv2.TERM_CRITERIA_EPS+cv2.TERM_CRITERIA_MAX_ITER,100,0.1)\n_,labels,cent=cv2.kmeans(Z,12,None,crit,20,cv2.KMEANS_PP_CENTERS)\ncent=cent.astype(int)\n# order labels by luminance, assign char\norder=np.argsort(cent.mean(1))\nchars='@%#*+=-:.oOxX'\nmp={k:chars[i] for i,k in enumerate(order)}\nprint('LEGEND')\nfor i,k in enumerate(order):print(chars[i],cent[k].tolist(), 'count', (labels==k).sum())\nfor y in range(90):\n print(''.join(mp[k] for k in labels.reshape(90,160)[y]))\nPY\"","aggregated_output":"LEGEND\n@ [7, 3, 2] count 895\n% [31, 19, 11] count 773\n# [67, 50, 2] count 1347\n* [55, 49, 45] count 286\n+ [81, 68, 11] count 1307\n= [86, 80, 76] count 812\n- [102, 99, 92] count 1407\n: [118, 114, 109] count 1326\n. [129, 126, 120] count 2266\no [187, 186, 27] count 170\nO [136, 135, 133] count 2615\nx [141, 143, 146] count 1196\n@@@@@@@@@@@@@@@@@%%@@%%#++++#+#####++++++++++++###################################################++++#######################################################%%%\n@@@@@@@@@@@@@@@@@%%@@%%#++++#####++++++++++++++##################################################+++++########################################################%%\n@@@@@@@@@@@@@@@@@@%@@%%##+++####+++++++++++##++#################################################+++++###########################################################\n@@@@@@@@@@@@@@@@@@%@@@%%##+++##+++++++++++++++#################################################+++##+###########################################################\n@@@@@@@@@@@@@@@@@@%%@@%%###++##++++++++++++++++++++###########################################+#################################################################\n@@@@@@@@@@@@@@@@@@@@@@@%###++###########+++++++++++++++++++++++++++##########################+##################################################################\n@@@@@@@@@@@@@@@@@@@@@@@%%############++++++++####+++#+++++++++++++++++++++#################