tColor(im,cv2.COLOR_RGB2GRAY)\n# contour approx for dark region x>800 y150:550\nfor val in [35,50,70,90,110]:\n m=((hsv[:,:,2]<val).astype(np.uint8)*255); m[:150]=0;m[560:]=0;m[:,:800]=0\n m=cv2.morphologyEx(m,cv2.MORPH_CLOSE,np.ones((7,7),np.uint8))\n co,_=cv2.findContours(m,cv2.RETR_EXTERNAL,cv2.CHAIN_APPROX_SIMPLE)\n print('\\\\nVAL',val)\n for c in sorted(co,key=cv2.contourArea,reverse=True)[:10]:\n  if cv2.contourArea(c)<100:continue\n  eps=cv2.approxPolyDP(c,5,True).reshape(-1,2).tolist()\n  print('area',round(cv2.contourArea(c)), 'bbox',cv2.boundingRect(c),'poly',eps[:30])\n# Hough long lines in ROI scene\nedges=cv2.Canny(gray,50,120)\nlines=cv2.HoughLinesP(edges,1,np.pi/180,threshold=70,minLineLength=60,maxLineGap=12)\nls=[]\nfor l in lines[:,0]:\n x1,y1,x2,y2=map(int,l); length=np.hypot(x2-x1,y2-y1); ang=np.degrees(np.arctan2(y2-y1,x2-x1))\n if y1>140 and y2>140: ls.append((round(length),round(ang,1),(x1,y1,x2,y2)))\nprint('\\\\nLINES')\nfor l in sorted(ls,reverse=True)[:100]:print(l)\nPY\"","aggregated_output":"\nVAL 35\narea 43626 bbox (866, 273, 414, 206) poly [[866, 385], [895, 425], [972, 460], [1049, 475], [1145, 476], [1225, 458], [1270, 430], [1279, 414], [1279, 334], [1224, 355], [1143, 366], [1042, 362], [949, 340], [965, 325], [993, 327], [997, 315], [1068, 286], [1056, 273], [877, 363]]\narea 648 bbox (865, 307, 52, 36) poly [[865, 307], [882, 342], [916, 328], [880, 307], [881, 317], [874, 318]]\n\nVAL 50\narea 48127 bbox (862, 264, 418, 215) poly [[862, 375], [886, 419], [952, 454], [1046, 475], [1148, 476], [1226, 458], [1279, 424], [1279, 325], [1268, 337], [1224, 354], [1150, 365], [1056, 363], [959, 344], [962, 334], [985, 327], [1030, 332], [1041, 324], [1027, 315], [1032, 304], [1063, 288], [1097, 293], [1112, 281], [1070, 264], [1060, 271], [1033, 267], [1033, 275], [1015, 284], [993, 285], [985, 302], [963, 304]]\narea 1192 bbox (863, 298, 55, 51) poly [[863, 302], [871, 321], [868, 348], [917, 328], [873, 298]]\narea 123 bbox (1004, 2