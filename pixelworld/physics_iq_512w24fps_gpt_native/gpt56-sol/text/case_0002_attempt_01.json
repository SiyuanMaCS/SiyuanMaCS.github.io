ef crop(x0,y0,x1,y1,s=2):\n a=im[y0:y1,x0:x1]\n H=((y1-y0)//s);W=((x1-x0)//s)\n a=a[:H*s,:W*s].reshape(H,s,W,s,3).mean((1,3))\n lum=a.mean(2); sat=a.max(2)-a.min(2); r=a[:,:,0];g=a[:,:,1];b=a[:,:,2]\n out=[]\n for y in range(H):\n  z=''\n  for x in range(W):\n   if lum[y,x]<15:c=' '\n   elif lum[y,x]<40:c='#'\n   elif sat[y,x]>60 and r[y,x]>g[y,x]+20:c='O'\n   elif sat[y,x]>25 and r[y,x]>g[y,x]+10:c='b'\n   elif lum[y,x]<75:c='x'\n   elif lum[y,x]<105:c='-'\n   elif lum[y,x]<125:c='+'\n   elif lum[y,x]<140:c='=' \n   elif lum[y,x]<160:c='*'\n   else:c='@'\n   z+=c\n  out.append(z)\n print(f'CROP {x0},{y0} to {x1},{y1} scale{s}')\n print('\\\\n'.join(out))\ncrop(85,0,195,100,2)\ncrop(365,0,450,135,2)\ncrop(0,160,512,288,4)\nPY\"","aggregated_output":"CROP 85,0 to 195,100 scale2\n                                                       \n            ######################       ############  \n################################         # ############\n          ##############xxxxxxxx#      #x-----------+++\n---------++++++++++++++++++=+++x       x+==============\n+++++++++++=================+x#        x+==============\n++++++++++===============+-x#           #x+============\n++++++==================-##          ##   #-===========\n+++++================+-x     #####xxxxxx#   -==========\n+++=================-# ########x##xxxxxxx## x+=========\n+=================+x################xxxxx## #-=========\n=================-####################xx### #-=========\n================-################xxxxxx####  -=========\n===============-############x-++======-###  #x=========\n===============x ########x-+==========-### ##x+========\n==============+x##x####x+=============+x# ###x=========\n==============-##x####-================-####x-=========\n==============x######-=================+# ##-==========\n=============-x#####x===++++++++=======+x##-===========\n=============x######-=++--------++======-#x+===========\n=============-######-+--xxxxxxxx--+=====-x-============\n=============-