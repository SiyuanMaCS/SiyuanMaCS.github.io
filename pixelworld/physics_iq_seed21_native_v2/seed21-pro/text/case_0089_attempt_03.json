unds[1:]):\n                offset = int(positions[start])\n                count = int(end - start)\n                packet.extend([offset, count])\n                packet.extend(current[offset:offset + count].tolist())\n        deltas.append(encode(packet))\n    data = {\n        \"id\": case_dir.name,\n        \"width\": w, \"height\": h, \"frames\": n, \"fps\": fps, \"audio\": audio_url,\n        \"first\": encode(packed[0].reshape(-1)),\n        \"deltas\": deltas,\n        \"caption\": (case_dir / \"prompt.txt\").read_text().strip(),\n    }\n    template = (Path(__file__).parent / \"player_template.html\").read_text()\n    payload = json.dumps(data, separators=(\",\", \":\"), ensure_ascii=False).replace(\"<\", \"\\\\u003c\")\n    (case_dir / \"index.html\").write_text(template.replace(\"__ID__\", case_dir.name).replace(\"__DATA__\", payload))\n=====TEMPLATE=====\n<!doctype html><html lang=\"en\"><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>PixelWorld · __ID__</title><style>*{box-sizing:border-box}body{margin:0;padding:16px;background:#101419;color:#eef3f7;font:14px system-ui,sans-serif}canvas{display:block;width:min(100%,768px);height:auto;image-rendering:pixelated;background:#080a0c;border-radius:8px;margin:auto}.controls{display:flex;align-items:center;gap:10px;flex-wrap:wrap;max-width:768px;margin:14px auto 0}button{background:#a5ef83;border:0;border-radius:7px;color:#142110;padding:9px 16px;font:inherit;font-weight:700;cursor:pointer}input[type=range]{flex:1;min-width:100px}.caption{max-width:768px;margin:12px auto;color:#a7b0be;font-size:12px;line-height:1.5}</style>\n<canvas id=\"canvas\" width=\"256\" height=\"144\"></canvas><div class=\"controls\"><button id=\"play\">Play</button><button id=\"replay\">Replay</button><input id=\"seek\" type=\"range\" min=\"0\" max=\"19\" value=\"0\"><output id=\"time\"></output><label><input id=\"loop\" type=\"checkbox\" checked> Loop</label></div><div id=\"capt