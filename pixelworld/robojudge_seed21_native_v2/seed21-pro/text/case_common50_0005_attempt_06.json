,sans-serif}canvas{display:block;width:min(100%,768px);height:auto;image-rendering:pixelated;background:#080a0c;border-radius:8px;margin:auto}.controls{display:flex;align-items:center;gap:10px;flex-wrap:wrap;max-width:768px;margin:14px auto 0}button{background:#a5ef83;border:0;border-radius:7px;color:#142110;padding:9px 16px;font:inherit;font-weight:700;cursor:pointer}input[type=range]{flex:1;min-width:100px}.caption{max-width:768px;margin:12px auto;color:#a7b0be;font-size:12px;line-height:1.5}</style>\n<canvas id=\"canvas\" width=\"256\" height=\"144\"></canvas><div class=\"controls\"><button id=\"play\">Play</button><button id=\"replay\">Replay</button><input id=\"seek\" type=\"range\" min=\"0\" max=\"19\" value=\"0\"><output id=\"time\"></output><label><input id=\"loop\" type=\"checkbox\" checked> Loop</label></div><div id=\"caption\" class=\"caption\"></div>\n<script>'use strict';const DATA=__DATA__,W=DATA.width||256,H=DATA.height||144,N=DATA.frames||20,FPS=DATA.fps||4;function unpack(s){const t=atob(s),b=new Uint8Array(t.length);for(let i=0;i<t.length;i++)b[i]=t.charCodeAt(i);return new Uint32Array(b.buffer)}const frames=[unpack(DATA.first)];for(const encoded of DATA.deltas){const f=new Uint32Array(frames.at(-1)),p=unpack(encoded);for(let i=0;i<p.length;){const start=p[i++],count=p[i++];f.set(p.subarray(i,i+count),start);i+=count}frames.push(f)}const canvas=document.getElementById('canvas'),ctx=canvas.getContext('2d');canvas.width=W;canvas.height=H;const img=ctx.createImageData(W,H);seek.max=N-1;const audio=DATA.audio?new Audio(DATA.audio):null;let frame=0,playing=false,raf=null,started=0;function draw(n){frame=Math.max(0,Math.min(N-1,n));const pixels=frames[frame];for(let i=0;i<pixels.length;i++){const v=pixels[i],p=i*4;img.data[p]=v>>>16;img.data[p+1]=(v>>>8)&255;img.data[p+2]=v&255;img.data[p+3]=255}ctx.putImageData(img,0,0);seek.value=frame;time.textContent=`${frame+1}/${N} · ${(frame/FPS).toFixed(2)} / ${(N/FPS).toFixed(2)}s`}function pause(){playing=false