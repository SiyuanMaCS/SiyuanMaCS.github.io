ox', tuple(round(x,1) for x in z))\nPY\"","aggregated_output":"00 060606 080808 0a0a0b 0c0c0c 0b0b0b 0b0b0b 0c0c0c 0c0c0c 0d0d0d 0d0d0d 0e0f0f 0e0d0e 0e0e0e 0e0d0c 040404 020202 020202 020202 030303 030303 030302 020202 020202 050807 020202 020202 020202 020202 030405 0c0c0c 0b0b0b 0b0b0b\n01 040404 030303 030303 030303 040404 060606 080808 090909 090807 060506 141415 111111 0b0c0b 343d43 0d0d0b 090909 090909 090909 090909 090909 090909 070707 050405 060707 0e1011 141416 414549 69696a 6d6d6e 6b6a6c 686868 676664\n02 585959 5c5d5d 616161 646567 6c6e6e 767676 7c7c7c 090a09 060606 8b8b8b 8c8c8c 8d8d8d 8d8c8c 878686 7e7d7d 727271 656463 616160 646566 717272 767671 7d7d7e 666460 515250 7c7c7c 7a7a7a 787878 767676 757575 717171 6f6f6f 6a6969\n03 5a5b5b 626363 686869 6e6e6f 757676 787766 101010 0f0f0f 0b0c10 8d8d8d 8f8f8f 8f8f8f 8f8f8f 8e8e8d 8a8a89 7f7e7c 717171 6a6a6a 6e6e70 787979 7f7f7f 808180 808080 7f7f7d 7e7e7e 7d7d7d 7a7a7a 787878 767676 727271 706f6f 6c6c6b\n04 5c5c5d 686868 6f6f6f 767676 7c7d7d 49413e 211f1f 1e2528 8f8f8f 929292 939393 939393 939393 929191 8e8e8e 878686 7e7e7e 7a7a7a 7c7c7c 818283 838484 838382 828383 838383 818080 7f7f7f 7d7d7d 7a7a7a 777777 767575 717171 6f6f6f\n05 5b5d60 686969 717275 777777 7f7f80 848484 423e39 8d8d8f 929293 949495 959595 969695 949594 939393 929291 8d8d8d 8d8d8c 8a8a8a 878788 8a8a8a 8a8a88 868585 858585 858484 838383 818080 7e7e7e 7c7c7c 787878 767676 727272 6f6f6f\n06 5c5d60 69696a 767676 7c7a7c 818383 878888 8d8d8d 919192 949494 969898 989898 999999 989898 949494 949494 939393 919191 8f8e8d 8c8c8c 8c8c8c 8b8b8b 8a8a8b 888786 868686 848484 838383 7f7f7f 7d7d7d 7a7979 777777 757572 70706f\n07 5c5c5e 686969 767676 7c7d7d 838384 888888 8d8d8e 929293 959595 989898 999999 9a9a9a 999999 989898 969696 949494 939393 919191 8f8f8f 8d8d8d 8c8c8c 8c8c8c 888a88 878686 858585 848484 807f7f 7e7d7d 7a7a7a 777677 757572 706f6f\n08 5b5b5c 686868 727575 7d7d7d 838384 878888 8d8d8d 929293 969696 989899 9a9a9a 9a9a9a 9a9a99 999999 989898 96969